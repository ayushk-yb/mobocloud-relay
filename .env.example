# Copy this file to a location OUTSIDE the git repo, e.g.
#   ~/.config/download-bot/download-bot.env
# then: chmod 600 ~/.config/download-bot/download-bot.env
#
# Every value below is a placeholder. Never fill in real values here or
# commit a filled-in copy of this file.

# From @BotFather after creating your bot. SECRET.
TELEGRAM_BOT_TOKEN=replace_me

# Comma-separated Telegram numeric user/chat IDs allowed to control the bot.
# See README "Finding your Telegram numeric ID". SECRET (personally identifying).
AUTHORIZED_CHAT_IDS=replace_me

# Your Transmission RPC endpoint, e.g. http://127.0.0.1:9091/transmission/rpc
TRANSMISSION_RPC_URL=replace_me
TRANSMISSION_RPC_USERNAME=replace_me
TRANSMISSION_RPC_PASSWORD=replace_me

# Your aria2 JSON-RPC endpoint, e.g. http://127.0.0.1:6800/jsonrpc
ARIA2_RPC_URL=replace_me
ARIA2_RPC_SECRET=replace_me

# Optional overrides (defaults shown are reasonable for most Termux installs).
# DOWNLOAD_BOT_STATE_DIR=~/.local/state/download-bot
# DOWNLOAD_BOT_DISK_PATH=~/storage/shared
